.holder {
    flex-grow: 0;
    width: 1300px;
    height: 800px;
    flex-shrink: 0;
    background-color: rgba(92, 52, 30, 0.98);
}

.corners {
    position: absolute;
    top: -8px;
    left: -8px;
    bottom: -8px;
    right: -8px;
}

.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.spaced-right {
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 0;
}
