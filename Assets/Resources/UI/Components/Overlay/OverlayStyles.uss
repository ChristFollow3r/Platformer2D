.inventory-holder {
    flex-grow: 1;
    right: 40px;
    position: absolute;
    top: 40px;
    align-items: flex-end;
    width: 415px;
}

.left {
    flex-grow: 1;
    right: auto;
    width: 60%;
    justify-content: center;
}

.item-name-holder {
    flex-grow: 0;
    position: absolute;
    align-self: flex-start;
    top: auto;
    right: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.67);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-right: 10px;
    padding-left: 10px;
    height: 40px;
    justify-content: center;
    align-items: center;
    max-width: none;
    width: auto;
    bottom: 30px;
}

.item-name {
    font-size: 18px;
    -unity-text-align: upper-left;
}

.item-text {
    -unity-text-align: upper-right;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
    text-shadow: 2px 2px 2px rgb(0, 0, 0);
}
