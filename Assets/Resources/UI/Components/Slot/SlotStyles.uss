.slot-root {
    flex-grow: 0;
    width: 75px;
    height: 75px;
    flex-shrink: 0;
    position: relative;
}

.slot-item-holder {
    flex-grow: 1;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    align-items: center;
    align-self: auto;
    align-content: auto;
    justify-content: center;
}

.slot-bg {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    picking-mode: ignore;
}
