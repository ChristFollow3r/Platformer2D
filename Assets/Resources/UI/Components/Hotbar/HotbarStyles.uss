

.hotbar-root {
    flex-grow: 0;
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
}

.hotbar-background {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    border-left-color: rgba(92, 52, 30, 0.7);
    border-right-color: rgba(92, 52, 30, 0.7);
    border-top-color: rgba(92, 52, 30, 0.7);
    border-bottom-color: rgba(92, 52, 30, 0.7);
}

.hand {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(204, 168, 114);
    border-right-color: rgb(204, 168, 114);
    border-top-color: rgb(204, 168, 114);
    border-bottom-color: rgb(204, 168, 114);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}
