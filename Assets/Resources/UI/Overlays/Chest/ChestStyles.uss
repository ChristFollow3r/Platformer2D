.chest-root {
    flex-shrink: 0;
    width: 415px;
    height: 100%;
    flex-direction: row;
    flex-grow: 1;
}

.chest-grid-holder {
    flex-grow: 1;
    right: 40px;
    position: absolute;
    top: 40px;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}

.chest-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}
