.furnace-root {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    flex-direction: row;
}

.fornace-list {
    justify-content: center;
}

.fornace-cooking {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.cooking-holder {
}

.cooking-slots {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: auto;
}

.cooking-grid {
    flex-grow: 0;
    flex-direction: row;
    flex-wrap: wrap;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
}

.cooking-progress {
    flex-grow: 0;
    width: 100%;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.cooking-fill {
    flex-grow: 1;
    width: 100%;
    height: 30px;
    background-color: rgb(204, 168, 114);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.fuel {
    flex-grow: 1;
    width: 100%;
    justify-content: flex-start;
    align-items: center;
    flex-direction: row-reverse;
}
