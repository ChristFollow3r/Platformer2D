.craft-root {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    flex-direction: row;
}

.equipment-crafting {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.crafing-holder {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: auto;
}

.crafting-grid {
    flex-grow: 0;
    flex-direction: row;
    flex-wrap: wrap;
    width: 330px;
    height: 330px;
    flex-shrink: 0;
}
